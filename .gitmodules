# whisper.cpp is pinned to the commit of tag v1.9.5 (d1be6fde11ac6e0407606b4e42fe72d34add8037) by the submodule
# entry itself. Our one patch is applied on top by scripts/setup-third-party.sh and checked by the CMake build.
[submodule "third_party/whisper.cpp"]
	path = third_party/whisper.cpp
	url = https://github.com/ggml-org/whisper.cpp.git
